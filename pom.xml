<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Same parent as current bigdataviewer-core; it pins versions matching Fiji. -->
	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>44.0.0</version>
		<relativePath />
	</parent>

	<groupId>io.github.ben-gitdev</groupId>
	<artifactId>bigdataviewer-movie-producer</artifactId>
	<version>0.1.0-SNAPSHOT</version>

	<name>BigDataViewer Movie Producer</name>
	<description>Keyframe-based movie producer for BigDataViewer (Fiji plugin), extracted from PreibischLab/bigdataviewer-core-movie.</description>
	<url>https://github.com/PreibischLab/bigdataviewer-core-movie</url>
	<inceptionYear>2022</inceptionYear>
	<organization>
		<name>BigDataViewer Movie Producer developers</name>
	</organization>
	<licenses>
		<license>
			<name>GNU General Public License v2+</name>
			<url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>mzouink</id>
			<name>Marwan Zouinkhi</name>
			<roles><role>founder</role></roles>
		</developer>
	</developers>
	<contributors>
		<contributor><name>Stephan Saalfeld</name></contributor>
		<contributor><name>Stephan Preibisch</name></contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/tag/bigdataviewer</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/PreibischLab/bigdataviewer-core-movie</connection>
		<url>https://github.com/PreibischLab/bigdataviewer-core-movie</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/PreibischLab/bigdataviewer-core-movie/issues</url>
	</issueManagement>
	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/PreibischLab/bigdataviewer-core-movie/actions</url>
	</ciManagement>

	<properties>
		<package-name>bdv.movie</package-name>
		<license.licenseName>gpl_v2</license.licenseName>
		<license.copyrightOwners>BigDataViewer Movie Producer developers.</license.copyrightOwners>
		<!-- Skip the strict release-readiness checks while this is a personal build. -->
		<enforcer.skip>true</enforcer.skip>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<!-- All "provided": Fiji already ships these, so the plugin jar contains only our classes. -->
	<dependencies>
		<dependency>
			<groupId>sc.fiji</groupId>
			<artifactId>bigdataviewer-core</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-common</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>ui-behaviour</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>net.imglib2</groupId>
			<artifactId>imglib2</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>net.imglib2</groupId>
			<artifactId>imglib2-realtransform</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>
</project>
